# Local-only planning and comparisons with the submitted study.
*.local.md
*.local.yaml
paths.local.yaml

# --- Never push: secrets, sealed partitions, environments, data copies -------
**/.mlca/private/
**/.mlca/env/
**/.mlca/data/
**/.mlca/*.lock
**/*.lock
.venv/
__pycache__/

# Prepared case-study tables (large; regenerated by each prepare_data.py)
data_prep/

**/.mlca/vault/
# Harness scratch: isolated XDG config/data homes (holds split-seal keys)
**/.isolated/

# Private AutoML partitions and fitted models
bench/automl/.work/
bench/automl-bio/.work/
automl/.venv/
!automl/requirements.lock

# Machine-specific Codespace monitor; not used by the study controller.
/scripts/codespace_keepalive.sh
